        "source": "static",
        "expression": "* * * * *"
      }
    },
    {
      "description": "function dispatch with an unencoded cron ce-vssexpression",
      "method": "POST",
      "headers": {
        "ce-specversion": "1.0",
        "ce-type": "com.vercel.schedule.v1beta",
        "ce-source": "/schedule/default/cleanup",
        "ce-id": "execution-4",
        "ce-vssscheduleid": "schedule-4",
        "ce-vssscheduledat": "2026-09-02T03:00:00.000Z",
        "ce-vssschedulename": "cleanup",
        "ce-vssnamespace": "default",
        "ce-vssschedulesource": "static",
        "ce-vssexpression": "0 3 * * *",
        "x-vercel-schedules-token": "opaque"
