      "expected": {
        "scheduleId": "schedule-4",
        "executionId": "execution-4",
        "name": "cleanup",
        "namespace": "default",
        "scheduledAt": "2026-09-02T03:00:00.000Z",
        "source": "static",
        "expression": "0 3 * * *"
      }
    },
    {
      "description": "path dispatch with legacy cron headers",
      "method": "POST",
      "headers": {
        "ce-specversion": "1.0",
        "ce-type": "com.vercel.schedule.v1beta",
        "ce-source": "/schedule/default/cleanup",
        "ce-id": "execution-4",
        "ce-vssscheduleid": "schedule-4",
        "ce-vssscheduledat": "2026-09-02T03:00:00.000Z",
        "ce-vssschedulename": "cleanup",
        "ce-vssnamespace": "default",
        "ce-vssschedulesource": "static",
        "ce-vssexpression": "0 3 * * *",
        "user-agent": "vercel-cron/1.0",
        "x-vercel-cron-schedule": "0 3 * * *",
        "authorization": "Bearer secret",
        "x-vercel-schedules-token": "opaque"
      },
      "expected": {
        "scheduleId": "schedule-4",
        "executionId": "execution-4",
        "name": "cleanup",
        "namespace": "default",
        "scheduledAt": "2026-09-02T03:00:00.000Z",
        "source": "static",
        "expression": "0 3 * * *"
      }
    },
    {
      "description": "unknown headers, including ce-time, are ignored",
      "method": "POST",
      "headers": {
        "ce-specversion": "1.0",
        "ce-type": "com.vercel.schedule.v1beta",
        "ce-source": "/schedule/default/cleanup",
        "ce-id": "execution-2",
        "ce-vssscheduleid": "schedule-2",
        "ce-vssscheduledat": "2026-09-02T12:00:00.000Z",
        "ce-vssschedulename": "cleanup",
        "ce-vssnamespace": "default",
        "ce-vssschedulesource": "dynamic",
        "ce-time": "2026-09-02T12:00:07.000Z",
        "ce-vssfuturefield": "value",
        "user-agent": "anything",
        "ce-vssexpression": "* * * * *"
      },
      "expected": {
        "scheduleId": "schedule-2",
        "executionId": "execution-2",
        "name": "cleanup",
        "namespace": "default",
        "scheduledAt": "2026-09-02T12:00:00.000Z",
        "source": "dynamic",
        "expression": "* * * * *"
      }
    }
  ],
  "reject": [
