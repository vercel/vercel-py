{
    "framework": null,
    "buildCommand": null,
    "outputDirectory": "public",
    "regions": ["iad1"],
    "rewrites": [
        {
            "source": "/",
            "destination": "/api"
        }
    ],
    "functions": {
        "api/index.py": {
            "maxDuration": 60
        },
        "api/scheduler.py": {
            "experimentalTriggers": [
                {
                    "type": "queue/v2beta",
                    "topic": "__aps_cleanup",
                    "maxConcurrency": 1
                }
            ]
        },
        "api/scheduler_watchdog.py": {
            "maxDuration": 60
        }
    },
    "crons": [
        {
            "path": "/api/scheduler_watchdog",
            "schedule": "* * * * *"
        }
    ]
}
